<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>
    <div class="w-full min-h-screen bg-zinc-900 text-white p-10">
        <a href="/" class="text-blue-500">Back to Home</a>
        
        <form action="/edit" method="post" class="mt-5 flex flex-col gap-3">
            <input class="px-3 py-2 bg-zinc-700 rounded-lg" type="text" name="prev" value="<%= filename %>">
            <input class="px-3 py-2 bg-zinc-700 rounded-lg" type="text" placeholder="New FileName" name="new">
            <button type="submit" class="bg-yellow-600 px-5 py-2 flex justify-center items-center">Update</button>
        </form>
    </div>
</body>
</html>