<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/stylesheets/style.css">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>
    <div class="w-full min-h-screen bg-zinc-900">
        <div class="form w-full p-10">
            <form action="/create" method="post" class="flex flex-col gap-2 text-white">
                <input class="px-6 py-3 bg-zinc-700 rounded-lg" type="text" placeholder="Title" name="title">
                <textarea class="px-6 py-3 bg-zinc-700 rounded-lg resize-none" placeholder="Description..." name="description"></textarea>
                <button type="submit" class="bg-blue-600 px-5 py-2 flex justify-center items-center">Create</button>
            </form>
        </div>


        <div class="tasks flex gap-3 flex-wrap p-10">
            <% if(files.length > 0){ %>
                <% files.forEach(function(val){ %>
                    <div class="task w-72 px-3 py-4 rounded-md bg-zinc-700 text-white">
                        <h2 class="text-xl tracking-tighter overflow-hidden"><%= val %></h2>
                        <div class="flex justify-between px-5 mt-3">
                            <a href="/file/<%= val %>" class="text-blue-500 inline-block">Read more.</a>
                            <a href="/edit/<%= val %>" class="text-zinc-400 inline-block">Edit</a>
                        </div>
                    </div>
                <% }) %>

            <% } else{ %>
                <h3 class="text-zinc-500">No Tasks yet.</h3>
            <% } %>
        </div>
    </div>

    <script src="/javascripts/script.js"></script>
</body>
</html>