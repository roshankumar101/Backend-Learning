<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>
    <div class="w-full h-screen bg-zinc-900 p-10 text-white">
        <h2 class="text-xl mb-5">Create User</h2>
        <form method="post" action="/create">
            <input class="px-4 py-2 border border-zinc-700 outline-none rounded-md" type="text" placeholder="Enter Username" name="username">
            <input class="px-4 py-2 border border-zinc-700 outline-none rounded-md" type="email" placeholder="Enter Email" name="email">
            <input class="px-4 py-2 border border-zinc-700 outline-none rounded-md" type="password" placeholder="Enter Password" name="password">
            <input class="px-4 py-2 border border-zinc-700 outline-none rounded-md" type="number" placeholder="Enter Age" name="age">
            <button class="px-5 py-2 bg-blue-500 rounded-lg" type="submit">Create</button>
        </form>
    </div>
</body>
</html>