<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="../public/stylesheets/style.css">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>
    <div class="w-full min-h-screen bg-zinc-900 text-white p-10">
        <a href="/" class="text-md text-blue-500 leading-tighter">< Back to Home</a>
        <h2 class="text-2xl leading-tighter font-bold mb-5">All Users</h2>
        <% if(users.length > 0) { %>
            <div class="p-3 flex gap-4 flex-wrap">
                <% users.forEach(function(user){ %>
                    <div class="w-52 h-76 bg-gray-700 rounded-xl p-2 overflow-hidden">

                        <div class="w-full h-48 bg-red-400 mb-2 rounded-md overflow-hidden">
                            <img src='<%= user.image %>' alt="" class="object-cover w-full h-full">
                        </div>

                        <h3 class="text-xl font-semibold text-center"><%= user.name %></h3>
                        <h5 class="text-md text-zinc-300 text-center"><%= user.email %></h5>

                        <div class="mt-1 flex justify-between px-2">
                            <a href="/edit/<%= user._id %>" class="bg-orange-500 px-4 py-1 rounded-md">Edit</a>
                            <a href="/delete/<%= user._id %>" class="bg-red-500 px-4 py-1 rounded-md">Delete</a>
                        </div>
                    </div>
                <% }) %>
            </div>
        <% } else { %>
            <div class="text-lg text-zinc-500 leading-tighter">No Users Yet</div>
        <% } %>
    </div>
</body>
</html>