<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="../public/stylesheets/style.css">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>
    <div class="w-full min-h-screen bg-zinc-900 text-white p-10">
        <a href="/read" class="text-md text-blue-500 leading-tighter mb-5">View All Users ></a>
        <form action="/create" method="post"class="mt-5">
            <input type="text" class="px-5 py-2 border border-zinc-600 rounded-md outline-none" placeholder="Enter Name" name="name">
            <input type="text" class="px-5 py-2 border border-zinc-600 rounded-md outline-none" placeholder="Enter Email" name="email">
            <input type="text" class="px-5 py-2 border border-zinc-600 rounded-md outline-none" placeholder="Enter Image" name="image">
            <button type="submit" class="px-6 py-2 bg-blue-500 rounded-md active:scale-95">Create</button>
        </form>
    </div>
</body>
</html>