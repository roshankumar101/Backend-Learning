<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>
    <div class="w-full min-h-screen bg-zinc-900 p-10 text-white">
        <h3 class="text-2xl mb-5">Create Your Account</h3>
        <form action="/register" method="post">
            <input class="px-5 py-2 rounded-md outline-none border-1 border-zinc-700" type="text" placeholder="Enter Name" name="name">
            <input class="px-5 py-2 rounded-md outline-none border-1 border-zinc-700" type="number" placeholder="Enter Age" name="age">
            <input class="px-5 py-2 rounded-md outline-none border-1 border-zinc-700" type="email" placeholder="Enter Email" name="email">
            <input class="px-5 py-2 rounded-md outline-none border-1 border-zinc-700" type="text" placeholder="Enter userName" name="username">
            <input class="px-5 py-2 rounded-md outline-none border-1 border-zinc-700" type="password" placeholder="Enter Password" name="password">
            <button class="px-5 py-2 rounded-md bg-blue-500" type="submit">Create Account</button>
        </form>
    </div>
</body>
</html>