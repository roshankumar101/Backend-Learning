<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body>
    <div class="w-full min-h-screen bg-zinc-900 p-10 text-white">
        <div class="w-full flex justify-between">
            <h3 class="text-2xl font-bold capitalize"><span class="font-light">Hello, </span><%= user.name %></h3>
            <a class="px-5 py-1 bg-red-500 rounded-lg" href="/logout">Logout</a>
        </div>

        <div class="p-5">
            <h4 class="text-lg mb-3">Create New Post.</h4>
            <form action="/post" method="post">
                <textarea class="w-1/3 resize-none border border-zinc-700 outline-none p-3 block" placeholder="Write Your Thoughts..." name="content"></textarea>
                <button class="px-5 py-2 text-sm bg-blue-500 rounded-md block mt-2" type="submit">Create Post</button>
            </form>
        </div>



        <div class="mt-15 posts">
            <h3 class="text-md text-zinc-400 mb-5">Your Posts</h3>

            <div class="postContainer w-full flex flex-wrap gap-3">

                <% user.posts.reverse().forEach(function(post) { %>
                    <div class="w-3/10 p-2 border-1 border-zinc-400 bg-zinc-800 rounded-md">
                        <h4 class="text-blue-500">@<%= user.name %></h4>
                        <p class="text-sm tracking-tigh pl-1"><%= post.content %></p>
                        <small class="mt-3 inline-block pl-1"><%= post.likes.length %> Likes</small>
                        <div class="flex gap-5">
                            <a href="/like/<%= post._id %>" class="text-blue-500">
                                <%= post.likes.indexOf(user._id) === -1 ? "Like" : "UnLike" %>
                            </a>
                            <a href="/edit/<%= post._id %>" class="text-zinc-500">edit</a>
                        </div>
                    </div>
                <% }) %>

            </div>
        </div>
    </div>
</body>

</html>