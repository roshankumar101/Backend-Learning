<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body>
    <div class="w-full min-h-screen bg-zinc-900 p-10 text-white">
        <div class="p-5">
            <h4 class="text-lg mb-3">Update Your Post.</h4>
            <form action="/update/<%= post._id %>" method="post">
                <textarea class="w-1/3 resize-none border border-zinc-700 outline-none p-3 block" name="content"><%= post.content %></textarea>
                <button class="px-5 py-2 mt-2 text-sm bg-yellow-500 rounded-md block" type="submit">Update Post</button>
            </form>
        </div> 
    </div>
</body>

</html>